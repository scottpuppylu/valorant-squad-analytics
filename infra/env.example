# TASK-INFRA-DATABASE-PORTABILITY-01 — copy to infra/env/production.env on the VPS (chmod 600; never commit).
# Every value below is a PLACEHOLDER. Generate real secrets on the server; never paste them into chat, docs or Git.

# PostgreSQL (private Docker network only). POSTGRES_DB / POSTGRES_USER are compose interpolation values; the database
# password lives in infra/env/postgres.env (see infra/postgres.env.example), which only the postgres container reads.
POSTGRES_DB=valorant
POSTGRES_USER=valorant

# Standard PostgreSQL connection string for the API/jobs (host = compose service name, private network).
DATABASE_URL=postgresql://valorant:CHANGE_ME@postgres:5432/valorant
# Optional, small by design (max 20): DATABASE_POOL_MAX=8
# Optional per-statement cap: DATABASE_STATEMENT_TIMEOUT_MS=55000

# Server-only application secrets
HENRIK_API_KEY=CHANGE_ME
IDENTIFIER_HMAC_KEY=CHANGE_ME_AT_LEAST_32_BYTES
CRON_SECRET=CHANGE_ME

# Public dataset read mode (exact value required to serve REAL data)
REAL_DATASET_READ_MODE=public

# Public site address for Caddy (real domain enables automatic HTTPS)
SITE_ADDRESS=localhost

# Backups (see infra/backup/backup-postgres.sh)
BACKUP_DIR=/var/backups/valorant
BACKUP_RETENTION_DAYS=14
