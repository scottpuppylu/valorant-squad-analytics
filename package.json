{
  "name": "valorant-squad-analytics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/assert-secret-boundary.mjs --dist",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:vercel": "tsx scripts/migrate-vercel.ts",
    "db:validate": "vitest run tests/databaseFoundation.test.ts",
    "consent:provision": "tsx scripts/provision-consent-management.ts",
    "deletion:retention": "tsx scripts/purge-expired-deletion-audits.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run && node scripts/assert-secret-boundary.mjs",
    "test:watch": "vitest",
    "vercel-build": "npm run db:migrate:vercel && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.9",
    "vitest": "^5.0.2"
  }
}
